      "unit": "count",
      "normalisation": "per_exposure",
      "higherIsBetter": true,
      "typical": [
        0.1,
        2.5
      ]
    },
    {
      "key": "passes_attempted",
      "label": "Passes attempted",
      "description": "All open-play and set-piece passes attempted.",
      "unit": "count",
      "normalisation": "per_exposure",
      "higherIsBetter": true,
      "typical": [
        20,
        80
      ]
    },
    {
      "key": "passes_completed",
      "label": "Passes completed",
      "description": "Passes that reached a team-mate.",
      "unit": "count",
      "normalisation": "per_exposure",
      "higherIsBetter": true,
      "typical": [
        14,
        72
      ]
    },
    {
      "key": "progressive_passes",
      "label": "Progressive passes",
      "description": "Completed passes starting outside the defensive 40% of the pitch that end at least 25% closer to the centre of the opponent's goal.",
      "unit": "count",
      "normalisation": "per_exposure",
      "higherIsBetter": true,
      "typical": [
        1,
        9
      ]
    },
    {
      "key": "progressive_carries",
      "label": "Progressive carries",
      "description": "Carries starting outside the defensive 40% of the pitch that end at least 25% closer to the centre of the opponent's goal.",
      "unit": "count",
      "normalisation": "per_exposure",
      "higherIsBetter": true,
      "typical": [
        0.5,
        6
      ]
    },
    {
      "key": "dribbles_completed",
      "label": "Successful dribbles",
      "description": "Take-ons that beat an opponent.",
      "unit": "count",
      "normalisation": "per_exposure",
      "higherIsBetter": true,
      "typical": [
        0.1,
        3
      ]
    },
    {
      "key": "pressures",
      "label": "Pressures",
      "description": "Pressure actions applied to an opponent in possession.",
      "unit": "count",
      "normalisation": "per_exposure",
      "higherIsBetter": true,
      "typical": [
        5,
        25
      ]
    },
    {
      "key": "tackles_won",
      "label": "Tackles won",
